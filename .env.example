# ============================================================
# .env.example — Variables de entorno del monorepo SGA
# Copia este archivo como .env.prod o .env.dev y rellena los valores reales
# ============================================================

# ── Identificación del Proyecto Compose ──────────────────────
COMPOSE_PROJECT_NAME=sga_prod

# ── Backend Flask ────────────────────────────────────────────
SECRET_KEY=cambiar-esto-por-una-clave-segura-en-produccion
AUDIT_LOG_ENABLED=True

# ── Puertos del Host Servidor ────────────────────────────────
BACKEND_PORT=5000
PDA_PORT=5173
PDA_CONTAINER_PORT=80
FRONTEND_PORT=5175
FRONTEND_CONTAINER_PORT=80

# ── Base de Datos Oracle ─────────────────────────────────────
ORACLE_USER=tu_usuario
ORACLE_PASSWORD=tu_contraseña
ORACLE_DSN=host:puerto/nombre_servicio
ORACLE_MIN=2
ORACLE_MAX=10

# Ruta al Oracle Instant Client DENTRO del contenedor Docker
# (no modificar si usas el Dockerfile estándar del backend)
ORACLE_CLIENT_PATH=/opt/oracle/instantclient_19_19

# ── Impresión de Etiquetas ───────────────────────────────────
PRINT_PDF_FOLDER=/app/print_queue

# ── Control de Sesiones en Terminales (minutos) ──────────────
SESSION_TIMEOUT_MINUTES=30

